<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>मास्टर एडमिन कंट्रोल पैनल</title>
    <script src="https://jsdelivr.net"></script>
</head>
<body class="bg-slate-900 text-white font-sans min-h-screen p-4 max-w-md mx-auto">

    <div class="bg-red-600 p-4 rounded-xl text-center font-bold text-xl shadow-lg mb-6">
        ⚙️ मुख्य एडमिन कंट्रोल पैनल ⚙️
        <p class="text-xs text-red-200 mt-1">यूज़र का कोई कंट्रोल नहीं है</p>
    </div>

    <!-- वर्तमान गेम स्थिति -->
    <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 mb-6">
        <p class="text-sm text-slate-400">अगला पीरियड नंबर:</p>
        <p class="text-xl font-mono font-bold text-yellow-400" id="adminPeriod">20261001001</p>
    </div>

    <!-- नतीजा फिक्स करने का सेक्शन -->
    <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 mb-6">
        <h3 class="text-lg font-semibold text-emerald-400 mb-4">🔮 अगला विजेता नंबर सेट करें:</h3>
        
        <div class="grid grid-cols-5 gap-3 mb-6">
            <!-- 0 से 9 नंबर सेट करने के बटन -->
            <button onclick="setNextResult(0, 'Violet')" class="num-btn bg-slate-700 hover:bg-emerald-600 py-3 font-bold rounded-lg border border-slate-600 transition">0 (बैंगनी)</button>
            <button onclick="setNextResult(1, 'Green')" class="num-btn bg-slate-700 hover:bg-emerald-600 py-3 font-bold rounded-lg border border-slate-600 transition">1 (हरा)</button>
            <button onclick="setNextResult(2, 'Red')" class="num-btn bg-slate-700 hover:bg-emerald-600 py-3 font-bold rounded-lg border border-slate-600 transition">2 (लाल)</button>
            <button onclick="setNextResult(3, 'Green')" class="num-btn bg-slate-700 hover:bg-emerald-600 py-3 font-bold rounded-lg border border-slate-600 transition">3 (हरा)</button>
            <button onclick="setNextResult(4, 'Red')" class="num-btn bg-slate-700 hover:bg-emerald-600 py-3 font-bold rounded-lg border border-slate-600 transition">4 (लाल)</button>
            <button onclick="setNextResult(5, 'Green')" class="num-btn bg-slate-700 hover:bg-emerald-600 py-3 font-bold rounded-lg border border-slate-600 transition">5 (हरा)</button>
            <button onclick="setNextResult(6, 'Red')" class="num-btn bg-slate-700 hover:bg-emerald-600 py-3 font-bold rounded-lg border border-slate-600 transition">6 (लाल)</button>
            <button onclick="setNextResult(7, 'Green')" class="num-btn bg-slate-700 hover:bg-emerald-600 py-3 font-bold rounded-lg border border-slate-600 transition">7 (हरा)</button>
            <button onclick="setNextResult(8, 'Red')" class="num-btn bg-slate-700 hover:bg-emerald-600 py-3 font-bold rounded-lg border border-slate-600 transition">8 (लाल)</button>
            <button onclick="setNextResult(9, 'Green')" class="num-btn bg-slate-700 hover:bg-emerald-600 py-3 font-bold rounded-lg border border-slate-600 transition">9 (हरा)</button>
        </div>

        <div class="p-3 bg-slate-900 rounded-lg border border-dashed border-slate-600 text-center">
            <p class="text-sm text-slate-400">वर्तमान लॉक किया गया नतीजा:</p>
            <p class="text-xl font-bold text-yellow-400 mt-1" id="lockedStatus">नंबर: 1 | रंग: Green</p>
        </div>
    </div>

    <script>
        // डिफ़ॉल्ट रूप से नंबर 1 सेट रहेगा जब तक आप बदलेंगे नहीं
        let fixedNumber = 1;
        let fixedColor = 'Green';

        function setNextResult(num, color) {
            fixedNumber = num;
            fixedColor = color;
            
            // UI पर अपडेट करें
            document.getElementById('lockedStatus').innerText = `नंबर: ${num} | रंग: ${color}`;
            
            // लोकल स्टोरेज में सेव करें ताकि यूज़र का पेज इसे पढ़ सके
            localStorage.setItem('adminFixedNumber', num);
            localStorage.setItem('adminFixedColor', color);
            
            // बटन का रंग बदलने के लिए विज़ुअल फीडबैक
            alert(`सफलतापूर्वक लॉक किया गया! अगला विजेता नंबर ${num} होगा।`);
        }

        // समय के साथ पीरियड नंबर को सिंक में रखने के लिए
        setInterval(() => {
            let currentPeriod = localStorage.getItem('currentPeriod') || 20261001001;
            document.getElementById('adminPeriod').innerText = currentPeriod;
        }, 1000);
    </script>
</body>
</html>